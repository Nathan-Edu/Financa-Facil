@startuml
title Diagrama de Casos de Uso - Finança Fácil

left to right direction

skinparam shadowing false
skinparam defaultFontSize 16
skinparam actorStyle stickman

skinparam usecase {
    BackgroundColor white
    BorderColor black
}

actor "Usuário" as U

rectangle "Finança Fácil" {

    usecase "Gerenciar\nSenha" as Senha
    usecase "Cadastrar\nUsuário" as Cadastro
    usecase "Consultar Informações\nFinanceiras" as Consultas
    usecase "Gerenciar Contas\nParceladas" as Parcelas
    usecase "Gerenciar\nCategorias" as Categorias
    usecase "Gerenciar Receitas\ne Despesas" as Movimentacoes
    usecase "Gerenciar Perfil\nFinanceiro" as Perfil
    usecase "Autenticar\nUsuário" as Login
    usecase "Gerenciar\nUsuários" as Usuarios
}

actor "Administrador" as A

U -- Senha
U -- Cadastro
U -- Consultas
U -- Parcelas
U -- Categorias
U -- Movimentacoes
U -- Perfil
U -- Login

A -- Login
A -- Usuarios

@enduml
