@startuml

title ACT09 - Autenticar Usuário

start

:Usuário acessa a tela de login;

repeat
  :Usuário informa e-mail e senha;

  if (Campos preenchidos?) then (Sim)
    :Sistema valida as credenciais;

    if (Credenciais válidas?) then (Sim)
      :Sistema libera o acesso;
      :Usuário acessa o painel financeiro;
    else (Não)
      :Sistema exibe mensagem de erro;
    endif

  else (Não)
    :Sistema solicita o preenchimento dos campos obrigatórios;
  endif

repeat while (Credenciais válidas?) is (Não)
-> Sim;

stop

@enduml
