@startuml

title ACT04 - Cadastrar Usuário

start

:Usuário acessa a tela de cadastro;

repeat
  :Usuário informa nome, e-mail e senha;

  if (Dados válidos?) then (Sim)

    :Sistema verifica se o e-mail já está cadastrado;

    if (E-mail já cadastrado?) then (Sim)
      :Sistema exibe mensagem informando que o e-mail já está em uso;
    else (Não)
      :Sistema registra o novo usuário;
      :Sistema exibe mensagem de confirmação do cadastro;
    endif

  else (Não)
    :Sistema exibe mensagem de dados inválidos;
  endif

repeat while (Dados válidos?) is (Não)
-> Sim;

stop

@enduml
