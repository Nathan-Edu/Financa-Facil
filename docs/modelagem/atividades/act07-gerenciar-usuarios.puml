@startuml

title ACT07 - Gerenciar Usuários

start

:Administrador acessa o sistema;
:Administrador seleciona o gerenciamento de usuários;
:Sistema lista os usuários cadastrados;
:Administrador seleciona um usuário;

if (Alterar status?) then (Sim)

  :Administrador seleciona o novo status;
  :Sistema atualiza o status do usuário;
  :Sistema exibe mensagem de confirmação;

else (Não)

  if (Alterar tipo de usuário?) then (Sim)

    :Administrador seleciona o novo tipo de usuário;
    :Sistema atualiza o tipo do usuário;
    :Sistema exibe mensagem de confirmação;

  else (Consultar)

    :Administrador consulta as informações do usuário;

  endif

endif

stop

@enduml