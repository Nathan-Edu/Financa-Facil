@startuml

title ACT07 - Gerenciar Usuários

start

:Administrador acessa o sistema;
:Administrador seleciona o gerenciamento de usuários;
:Sistema lista os usuários cadastrados;
:Administrador seleciona um usuário;

if (Editar usuário?) then (Sim)

  repeat
    :Administrador altera as informações do usuário;

    if (Dados válidos?) then (Sim)
      :Sistema atualiza o cadastro do usuário;
    else (Não)
      :Sistema exibe mensagem de erro;
    endif

  repeat while (Dados válidos?) is (Não)
  -> Sim;

else (Não)

  if (Excluir usuário?) then (Sim)

    :Administrador confirma a exclusão;

    if (Confirmação válida?) then (Sim)
      :Sistema remove o usuário;
    else (Não)
      :Sistema cancela a operação;
    endif

  else (Consultar)

    :Administrador consulta as informações do usuário;

  endif

endif

:Sistema exibe mensagem de confirmação;

stop

@enduml
