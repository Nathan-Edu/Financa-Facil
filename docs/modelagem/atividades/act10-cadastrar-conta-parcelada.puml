@startuml
title ACT10 - Cadastrar Conta Parcelada

skinparam shadowing false
skinparam defaultFontSize 16

start

:Usuário acessa a área\nde contas parceladas;

:Usuário seleciona\ncadastrar conta parcelada;

repeat

  :Usuário informa ou corrige\nos dados da conta parcelada;

  note right
    Descrição
    Categoria
    Valor total
    Quantidade de parcelas
    Data da compra
    Primeiro vencimento
  end note

  :Sistema valida os dados,\no perfil, a categoria e as datas;

  if (Dados inválidos?) then (Sim)
    :Sistema exibe mensagem de erro;
  endif

repeat while (Dados inválidos?) is (Sim) not (Não)

:Sistema distribui o valor\nentre as parcelas;

:Sistema calcula\nos vencimentos;

:Sistema registra a conta parcelada\ne suas parcelas;

:Sistema registra a operação\nna auditoria;

:Sistema exibe mensagem\nde confirmação;

stop

@enduml
