@startuml

title ACT11 - Gerar Relatório Financeiro

start

:Usuário acessa a área de relatórios;

repeat
  :Usuário seleciona o período e o perfil financeiro;

  if (Filtros válidos?) then (Sim)
    break
  else (Não)
    :Sistema solicita o ajuste dos filtros;
  endif

repeat while (Filtros válidos?) is (Não)

:Sistema consulta as movimentações financeiras;
:Sistema organiza os dados financeiros;
:Sistema gera gráficos e resumo;
:Sistema exibe o relatório;

if (Exportar relatório?) then (Sim)
  :Sistema gera o relatório em formato PDF;
  :Sistema disponibiliza o arquivo ao usuário;
else (Não)
endif

stop

@enduml
