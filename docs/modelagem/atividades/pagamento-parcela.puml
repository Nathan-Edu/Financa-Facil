@startuml

title ACT10 - Cadastrar Conta Parcelada

start

:Usuário acessa a área de contas parceladas;
:Usuário seleciona a opção de cadastrar conta parcelada;

repeat
  :Usuário informa descrição, valor total,\nquantidade de parcelas e vencimento;

  if (Dados válidos?) then (Sim)
    :Sistema calcula o valor das parcelas;
    :Sistema gera as parcelas;
    :Sistema registra a conta parcelada;
    :Sistema exibe mensagem de confirmação;
  else (Não)
    :Sistema exibe mensagem de erro;
  endif

repeat while (Dados válidos?) is (Não)
-> Sim;

stop

@enduml
