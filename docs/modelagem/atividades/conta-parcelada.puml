@startuml

title ACT05 - Registrar Pagamento de Parcela

start

:Usuário acessa as contas parceladas;
:Usuário seleciona uma conta;
:Usuário seleciona uma parcela em aberto;

repeat
  :Usuário confirma o pagamento;

  if (Parcela está pendente ou vencida?) then (Sim)
    :Sistema registra o pagamento;
    :Sistema atualiza o status da parcela para paga;
    :Sistema atualiza os cálculos financeiros;
    :Sistema exibe mensagem de confirmação;
  else (Não)
    :Sistema informa que a parcela não pode ser paga novamente;
  endif

repeat while (Parcela está pendente ou vencida?) is (Não)
-> Sim;

stop

@enduml
