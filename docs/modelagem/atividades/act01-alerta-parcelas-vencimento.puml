@startuml
title ACT01 - Alerta de Parcelas Próximas do Vencimento

start

repeat
  :Sistema verifica as contas parceladas;
  :Sistema identifica parcelas com vencimento em até 7 dias;

  if (Existem parcelas próximas do vencimento?) then (Sim)
    :Sistema gera o alerta de vencimento;
    :Sistema disponibiliza o alerta ao usuário;
  else (Não)
    :Sistema não gera alerta;
  endif

repeat while (Continuar monitorando?) is (Sim)
-> Não;

stop

@enduml
