@startuml

title ACT06 - Gerenciar Categorias Financeiras

start

:Usuário acessa a área de categorias;
:Usuário seleciona a ação desejada;

if (Criar categoria?) then (Sim)

  repeat
    :Usuário informa nome e tipo da categoria;

    if (Dados válidos?) then (Sim)
      :Sistema registra a nova categoria;
    else (Não)
      :Sistema exibe mensagem de erro;
    endif

  repeat while (Dados válidos?) is (Não)
  -> Sim;

else (Não)

  if (Editar categoria?) then (Sim)

    :Usuário seleciona uma categoria existente;

    repeat
      :Usuário altera as informações da categoria;

      if (Dados válidos?) then (Sim)
        :Sistema atualiza a categoria;
      else (Não)
        :Sistema exibe mensagem de erro;
      endif

    repeat while (Dados válidos?) is (Não)
    -> Sim;

  else (Excluir)

    :Usuário seleciona uma categoria;
    :Sistema remove a categoria;

  endif

endif

:Sistema exibe mensagem de confirmação;

stop

@enduml
