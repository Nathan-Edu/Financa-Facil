@startuml
title ACT03 - Cadastrar Receita

start

:Usuário acessa o painel financeiro;
:Usuário seleciona a opção de cadastrar receita;

repeat
  :Usuário informa valor, data, categoria e descrição;

  if (Dados válidos?) then (Sim)
    :Sistema registra a receita;
    :Sistema atualiza o saldo financeiro;
    :Sistema exibe mensagem de confirmação;
  else (Não)
    :Sistema exibe mensagem de erro;
  endif

repeat while (Dados válidos?) is (Não)
-> Sim;

stop

@enduml
