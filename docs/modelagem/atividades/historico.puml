@startuml

title ACT08 - Consultar Movimentações Financeiras

start

:Usuário acessa a área de movimentações financeiras;

repeat
  :Usuário informa os filtros de busca;

  if (Filtros informados?) then (Sim)

    if (Filtros válidos?) then (Sim)
      :Sistema busca as movimentações conforme os filtros informados;
    else (Não)
      :Sistema exibe mensagem de filtro inválido;
    endif

  else (Não)
    :Sistema lista todas as movimentações financeiras;
  endif

repeat while (Filtros válidos?) is (Não)
-> Sim;

:Sistema exibe as movimentações ao usuário;

stop

@enduml
