@startuml

title Diagrama de Classes - Finança Fácil

top to bottom direction

skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 70
skinparam linetype ortho


class Usuario {
  -idUsuario: int
  -nome: string
  -email: string
  -senha: string
  -tipoUsuario: string
  +cadastrar()
  +autenticar()
  +alterarSenha()
}


class PerfilFinanceiro {
  -idPerfil: int
  -nome: string
  -tipo: string
  -cpfCnpj: string
  -renda: decimal
  +cadastrar()
  +editar()
  +excluir()
}


class Categoria {
  -idCategoria: int
  -nome: string
  -tipo: string
  +cadastrar()
  +editar()
  +excluir()
}


abstract class Transacao {
  -idTransacao: int
  -valor: decimal
  -data: date
  -descricao: string
  -status: string
  +registrar()
  +editar()
  +excluir()
}


class Receita {
  -origemReceita: string
  -recorrente: boolean
  +registrarReceita()
}


class Despesa {
  -formaPagamento: string
  -dataVencimento: date
  -paga: boolean
  +registrarDespesa()
  +marcarComoPaga()
}


class ContaParcelada {
  -idConta: int
  -descricao: string
  -valorTotal: decimal
  -quantidadeParcelas: int
  -dataCompra: date
  -status: string
  +gerarParcelas()
  +calcularValorParcela()
  +cancelar()
}


class Parcela {
  -idParcela: int
  -numero: int
  -valor: decimal
  -dataVencimento: date
  -dataPagamento: date
  -status: string
  +registrarPagamento()
  +alterarStatus()
}


class Relatorio {
  -tipo: string
  -periodoInicial: date
  -periodoFinal: date
  +gerarRelatorio()
  +exportarPDF()
}


class Alerta {
  -idAlerta: int
  -mensagem: string
  -dataAlerta: date
  -lido: boolean
  +gerarAlerta()
  +marcarComoLido()
}


' Organização visual

Usuario -[hidden]down- PerfilFinanceiro

Receita -[hidden]right- Transacao
Transacao -[hidden]right- Despesa

Categoria -[hidden]right- ContaParcelada
ContaParcelada -[hidden]right- Parcela

Relatorio -[hidden]right- Alerta


' Relacionamentos

Usuario "1" -- "0..*" PerfilFinanceiro

PerfilFinanceiro "1" -- "0..*" Transacao
PerfilFinanceiro "1" -- "0..*" Categoria
PerfilFinanceiro "1" -- "0..*" ContaParcelada
PerfilFinanceiro "1" -- "0..*" Alerta

Categoria "1" -- "0..*" Transacao

ContaParcelada "1" *-- "1..*" Parcela

Relatorio ..> PerfilFinanceiro
Relatorio ..> Transacao

Receita --|> Transacao
Despesa --|> Transacao

@enduml
